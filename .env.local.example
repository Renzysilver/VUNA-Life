# ==========================================================================
# VUNA Life — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Until Supabase keys are set, the app runs in DEMO_MODE using local
# SQLite + seeded campus data, so you can see the UI without live infra.
# ==========================================================================

# --- App ---
# Public URL of the deployed site. Used to build absolute links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "true" to force DEMO_MODE (visible OTP, local data, no real email).
# Auto-enabled when Supabase env vars are missing. Leave unset in production.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Auth / OTP signing ---
# 32+ random chars used to sign OTP tokens + session JWTs.
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-me-with-a-32-byte-hex-secret"

# --- Supabase (PostgreSQL, Auth, Realtime) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
# Anon public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Upstash Redis (rate limits, QR rotation, caps) ---
# Leave empty until Phase 3+; we only need Redis for QR token rotation
# and hello cooldowns. DEMO_MODE uses in-memory caches as a fallback.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email domain whitelist for verification ---
# Comma-separated list of allowed school email domains.
# EMPTY (default) = verification is CLOSED. No domain passes the check
# until you populate this. Treat example domains as unverified guesses.
# Example (do not assume these are correct — confirm with the school first):
# ALLOWED_EMAIL_DOMAINS="veritas.edu.ng,students.veritas.edu.ng"
ALLOWED_EMAIL_DOMAINS=""

# --- Local DB (DEMO_MODE only) ---
# Used by Prisma for the local SQLite dev adapter. Ignored when Supabase
# is configured (the app routes through @supabase/supabase-js instead).
DATABASE_URL="file:/home/z/my-project/db/vuna-life.db"
